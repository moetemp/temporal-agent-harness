load("@aspect_rules_py//py:defs.bzl", "py_library")
load("//bazel:pytest.bzl", "harness_pytest_test")

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    imports = [".."],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "conftest",
    testonly = True,
    srcs = ["conftest.py"],
    imports = [".."],
    visibility = ["//:__subpackages__"],
    deps = [
        "//python/temporal_agent_harness:plugin",
        "//python/temporal_agent_harness/harness:contrib_stream",
        "//python/temporal_agent_harness/harness:contrib_stream_activities",
        "@pypi//temporalio",
    ],
)

harness_pytest_test(
    name = "test_packaged_distributions",
    srcs = ["test_packaged_distributions.py"],
    data = ["//python:dists"],
    env = {"PYTHON_DISTS": "$(rootpath //python:dists)"},
    imports = [".."],
    deps = [
        # The package's third-party dependencies, for importing the extracted wheel.
        "//python/temporal_agent_harness",  # keep
        ":conftest",
        "@pypi//pytest",
    ],
)

harness_pytest_test(
    name = "test_development",
    srcs = ["test_development.py"],
    imports = [".."],
    deps = [
        ":conftest",
        "//python/temporal_agent_harness:development",
        "//python/temporal_agent_harness/web:cli",
        "//python/temporal_agent_harness/web:dev",
        "//python/temporal_agent_harness/web:doctor",
        "@pypi//pytest",
    ],
)

py_library(
    name = "_streams",
    srcs = ["_streams.py"],
    imports = [".."],
    visibility = ["//python:__subpackages__"],
    deps = [
        "//python/temporal_agent_harness/harness:contrib_stream",
        "//python/temporal_agent_harness/harness/agent_protocol:__init__",
        "@pypi//temporalio",
    ],
)
